      <aliases enabled='yes' />
      <column caption='Late Delivery Rate' datatype='real' name='[Calculation_2406463127396354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [order_status] = &quot;delivered&quot;&#10;       AND [delivered_late] = TRUE&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [order_status] = &quot;delivered&quot;&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Delivered Orders' datatype='integer' name='[Calculation_2406463128915971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [order_status] = &quot;delivered&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Late Deliveries' datatype='integer' name='[Calculation_2406463133302788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_status] = &quot;delivered&quot;&#10;AND [delivered_late] = TRUE&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
